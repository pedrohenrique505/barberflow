{
  "name": "barberflow",
  "version": "0.1.0",
  "private": true,
  "description": "Mini-SaaS for barbershop scheduling and management.",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --recursive dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "prisma:generate": "pnpm --filter api prisma:generate"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  }
}
